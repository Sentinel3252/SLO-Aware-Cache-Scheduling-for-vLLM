include LICENSE README.md README.zh-CN.md
include CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md CHANGELOG.md ROADMAP.md
include .editorconfig .gitattributes
recursive-include docs *.md
recursive-include requirements *.txt
recursive-include scripts *.py *.sh
recursive-include tests *.py
prune interview
prune .local
prune results
prune benchmark/traces
global-exclude __pycache__ *.py[cod]
